# Set these in the deployment process; do not commit capability values.
STATEFUL_RELAY_DATABASE_PATH=
STATEFUL_RELAY_GPT_CAPABILITY=
STATEFUL_RELAY_CODEX_CAPABILITY=
STATEFUL_RELAY_CODEX_CONSUMER_ID=stateful-relay-codex
STATEFUL_RELAY_CLASSROOM_PROJECT_ID=classroom
STATEFUL_RELAY_BOUNDED_WRITE_ENABLED=false
STATEFUL_RELAY_BOUNDED_WRITE_CAPABILITY=
# Existing canonical user Skill root; the operation owns the leaf name.
STATEFUL_RELAY_BOUNDED_WRITE_TRUSTED_SKILL_ROOT=
STATEFUL_RELAY_BOUNDED_WRITE_EXECUTION_MODE=normal_native_codex_mailbox_v1
# Formal installer consumer is a separate Native Codex one-shot; keep the
# capability disabled until the explicit installation gate is authorized.
STATEFUL_RELAY_BOUNDED_WRITE_INSTALLER_MODE=stateful_skill_v1
# Direct-spawn deployment-test runner only; never use as the formal live path.
# STATEFUL_RELAY_CODEX_RUNTIME_PATH=
# STATEFUL_RELAY_CODEX_RUNTIME_SHA256=
MCP_PORT=
