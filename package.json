{
  "name": "stateful-agent-relay",
  "version": "1.0.0-stateful-relay.3",
  "private": false,
  "type": "module",
  "description": "A bounded durable mailbox between GPT and a native Codex session.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./stateful-agent-relay-store.mjs",
    "./notification": "./stateful-agent-relay-notification.mjs",
    "./manual-dispatch": "./stateful-agent-relay-manual-dispatch.mjs",
    "./recovery": "./stateful-agent-relay-recovery.mjs",
    "./operator": "./stateful-agent-relay-operator.mjs",
    "./consumer": "./stateful-agent-relay-consumer.mjs",
    "./bounded-write": "./stateful-relay-bounded-write.mjs",
    "./native-bounded-write": "./stateful-relay-native-bounded-write.mjs",
    "./native-mailbox-bounded-write": "./stateful-relay-native-mailbox-bounded-write.mjs",
    "./native-skill-installer": "./stateful-relay-native-skill-installer.mjs",
    "./native-consumer": "./native-agent-relay-consumer.mjs",
    "./lifecycle": "./stateful-agent-relay-lifecycle.mjs",
    "./schema": "./stateful-relay-result.schema.json",
    "./mcp-adapter": "./stateful-relay-mcp-adapter.mjs",
    "./execution-registry": "./stateful-relay-execution-registry.mjs",
    "./native-wakeup": "./stateful-relay-native-wakeup.mjs",
    "./native-readonly-executor": "./stateful-relay-native-readonly-executor.mjs",
    "./windows-native-wakeup-sink": "./deployment/windows-stateful-relay-native-wakeup-sink.mjs",
    "./mcp-server": "./mcp-server.mjs"
  },
  "scripts": {
    "test": "node --test",
    "start": "node mcp-server.mjs",
    "bounded-write-consumer": "node stateful-relay-native-bounded-write.mjs",
    "bounded-write-mailbox-consumer": "node stateful-relay-native-mailbox-bounded-write.mjs",
    "bounded-write-skill-installer": "node stateful-relay-native-skill-installer.mjs --once"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
